# Database connection URL using SQLite with the asynchronous aiosqlite driver.
DATABASE_URL=sqlite+aiosqlite:///./data/todo.db

# Secret key used to sign and verify JWT tokens. REQUIRED: the app refuses to start
# without it because this example value is public. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# JWT access token expiration time in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application environment. The API docs (/api/docs, /api/redoc and
# /api/openapi.json) are only served with "development"; any other value
# closes them (SEG-H07). Keep "production" for any deployment.
ENVIRONMENT=production

# Minimum log level (DEBUG, INFO, WARNING, ERROR). Log lines include the
# request id, so an error reported by a client can be found in the logs.
LOG_LEVEL=INFO

# Expose Prometheus HTTP metrics at /metrics (keep internal behind reverse proxy).
METRICS_ENABLED=true

# LDAP directory login (F1). Leave disabled to keep local email/password.
LDAP_ENABLED=false
LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(mail={email})
LDAP_TIMEOUT_SECONDS=5

# HttpOnly session cookie (F2). The browser must send credentials and must
# not copy the JWT into localStorage. AUTH_COOKIE_SECURE empty means secure
# only when ENVIRONMENT=production. SameSite=none requires secure=true.
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=true
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Sentry (F4). Leave the DSN empty to disable the SDK.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Production / Cloud Deployment (docker-compose.prod.yml) ---
# Public domain pointing to the server (required for TLS/Let's Encrypt).
DOMAIN=
# Email used by Let's Encrypt for certificate expiration notices.
CERTBOT_EMAIL=
# Optional: override GHCR images (e.g. when deploying from a fork).
# BACKEND_IMAGE=ghcr.io/josette320985/todo-backend:latest
# FRONTEND_IMAGE=ghcr.io/josette320985/todo-frontend:latest
# Optional: restrict CORS_ORIGINS to your HTTPS domain in production.
# CORS_ORIGINS=["https://todo.example.com"]