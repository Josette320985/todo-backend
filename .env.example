# Database connection URL using SQLite with the asynchronous aiosqlite driver.
DATABASE_URL=sqlite+aiosqlite:///./data/todo.db

# Secret key used to sign and verify JWT tokens.
# Replace this placeholder with a strong, randomly generated key of at least 32 characters.
SECRET_KEY=reemplaza-esta-clave-por-una-larga-y-aleatoria-de-al-menos-32-caracteres

# JWT access token expiration time in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
